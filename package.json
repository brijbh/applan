{
  "name": "applan",
  "version": "0.1.0",
  "description": "Give your npm/Vite/CRA/Next dev server a friendly LAN-visible name (http://appname.local:PORT) instead of hunting for an IP address. Zero privilege, zero persisted state.",
  "type": "module",
  "bin": {
    "applan": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "dev-server",
    "mdns",
    "bonjour",
    "lan",
    "vite",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
